{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/scripts/maintainer-status.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "remember@claude-plugins-official": false
  },
  "permissions": {
    "allow": [
      "Bash(git fetch)",
      "Bash(git fetch origin)",
      "Bash(git fetch -q origin)",
      "Bash(git fetch origin --tags)",
      "Bash(git fetch -q origin --tags)",
      "Bash(git merge-base *)",
      "Bash(git merge-tree *)",
      "Bash(git ls-tree *)",
      "Bash(sysctl -n vm.loadavg)",
      "Bash(gh label list *)",
      "Bash(pg_isready)",
      "Bash(python3 scripts/lint_self_consistency.py)",
      "Bash(gh search *)",
      "Bash(python3 scripts/maintainer_doctor.py --gates-only --fast)"
    ]
  }
}
