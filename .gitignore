.DS_Store
Thumbs.db
*.swp

.claude/settings.local.json

# Guard against drag-drop pollution: plugin files belong under plugins/** and
# .claude-plugin/**, never at the repo root. These root-anchored ignores catch strays.
/*.sh
/hooks.json
/marketplace.json
/plugin.json
.env

# Byte-code from running the shipped Python tooling (scripts/, plugins/**/scripts/)
__pycache__/
*.pyc

# Paid third-party book screenshots (Every Layout) — reference only, never redistribute.
# Licensed design references — study locally, NEVER commit (see EPIC #89).
# They live in a SEPARATE PRIVATE repo for cross-machine cloning, never in this history:
# committing ~656 MB of licensed blobs here could only be undone with `git filter-repo` +
# a force-push, which rewrites every commit SHA and detaches the release tags.
everylayout/
tailwind-ui/
flowbite*/
flowbite*.zip

# Dependency trees are never committed. (Was missing: the flowbite bundles carry two
# node_modules trees, which `flowbite*/` happened to cover — this makes it explicit.)
node_modules/
