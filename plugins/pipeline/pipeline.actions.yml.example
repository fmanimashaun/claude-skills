# DORMANT — copy to .github/workflows/pipeline.yml ONLY when you have Actions minutes
# to spare. Runs the release build on push to main after certification. Uses ghcr via
# the built-in GITHUB_TOKEN (no extra secret). Costs Actions minutes when enabled.
name: pipeline-release
on:
  push:
    branches: [main]
permissions:
  contents: read
  packages: write
jobs:
  release:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Log in to ghcr
        run: echo "${{ secrets.GITHUB_TOKEN }}" | docker login ghcr.io -u ${{ github.actor }} --password-stdin
      # The build is `release_build.py`, the SAME script `/pipeline:release` runs, so the two cannot read pipeline.yml
      # differently (#1701): each `build_args` entry is a --build-arg, each `labels` entry a --label, `{{sha}}` and
      # `{{release_name}}` are substituted exactly (set RELEASE_NAME in this step's env to name the release; default: the
      # sha), a pipeline.yml it cannot read is exit 2, and with neither key set the build is the bare one. Copy
      # `plugins/pipeline/scripts/release_build.py` from the plugin into the project as `.github/scripts/release_build.py`
      # (python3 is on the runner; the script is stdlib only). The step stops when the build fails (Actions runs `bash -e`),
      # so a failed build never reaches the push.
      - name: Build and push
        run: |
          IMAGE=ghcr.io/${{ github.repository }}
          SHA=$(git rev-parse --short HEAD)
          python3 .github/scripts/release_build.py --image "$IMAGE" --sha "$SHA"
          docker push "$IMAGE:$SHA" && docker push "$IMAGE:latest"
