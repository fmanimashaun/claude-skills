{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -p \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/release-gate.sh\"",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -p \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/qa-status.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
