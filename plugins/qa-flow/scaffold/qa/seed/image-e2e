#!/usr/bin/env bash
# `qa/seed/image-e2e [playwright args]` (qa-flow #1837, lifted from Retask #826): the QA robot's corpus, run against the RELEASE IMAGE
# started on this machine (its own database and Mailpit), not a dev server. It boots nothing and mints nothing: the stack must be up and
# the project's seed must have run, and it runs the specs tagged @qa-image (QA_GREP to change) from the browser states the seed kept.
#
#   QA_BASE_URL   required; must dial 127.0.0.1, localhost or ::1 (parsed, no userinfo) -- exit 2 otherwise
#   QA_UP_PATH    health path that must answer before anything runs (default /up); a plain path, no `@`, `?`, `#` or `//`
#   QA_SEED_DIR   where the seed wrote personas.json and records.json; a relative value is read from the directory you
#                 run this from (default: qa/.qa-seed, the same default as qa/e2e/support/personas.ts)
# Playwright args are passed through, except --retries: this runner's --retries=0 is not negotiable (exit 2).
set -euo pipefail
case "${QA_SEED_DIR:-}" in "") seed="$PWD/qa/.qa-seed" ;; /*) seed="$QA_SEED_DIR" ;; *) seed="$PWD/$QA_SEED_DIR" ;; esac
for arg in "$@"; do case "$arg" in --retries|--retries=*) echo "image-e2e: --retries is fixed at 0 here (a retry can turn a real failure into a pass)" >&2; exit 2 ;; esac; done
up_path="${QA_UP_PATH:-/up}"
if ! [[ "$up_path" =~ ^/[A-Za-z0-9/_.-]*$ ]] || [[ "$up_path" == //* ]]; then
  echo "image-e2e: QA_UP_PATH must be a plain path like /up (got \"$up_path\"): text appended to the origin could change the host it dials" >&2; exit 2
fi
cd "$(dirname "$0")/.."
: "${QA_BASE_URL:?QA_BASE_URL is required: the release image started on this machine, e.g. http://127.0.0.1:3000}"
# THE PARSED HOSTNAME, not a prefix of the text: `https://127.0.0.1:x@prod.example.com/` names the production host.
# Everything after this uses the ORIGIN the guard printed, never the raw text the caller gave.
origin="$(node --experimental-strip-types --no-warnings seed/assert-local-target.ts "$QA_BASE_URL")" || exit 2
if [ -n "${QA_MAILPIT_URL:-}" ]; then node --experimental-strip-types --no-warnings seed/assert-local-target.ts "$QA_MAILPIT_URL" >/dev/null || exit 2; fi
curl -sk -o /dev/null -f --max-time 5 "${origin}${up_path}" \
  || { echo "image-e2e: nothing answers at ${origin}${up_path} -- start the release image first" >&2; exit 1; }
[ -s "$seed/personas.json" ] && [ -s "$seed/records.json" ] \
  || { echo "image-e2e: no QA seed in $seed (personas.json and records.json are both needed) -- run the project's seed first" >&2; exit 1; }
# A MISSING SEED MUST FAIL THE RUN, not skip it: a run in which every test skipped exits 0. This runner refuses to start without
# one. QA_REQUIRE_SEED=1 is exported for the project's own specs to read (fail, not skip, when the seed is gone mid-run); no spec in
# this scaffold reads it yet. `--retries=0`: a retry can turn a real failure into a pass.
export QA_REQUIRE_SEED=1
exec npx playwright test --grep "${QA_GREP:-@qa-image}" --workers=1 --retries=0 "$@"
