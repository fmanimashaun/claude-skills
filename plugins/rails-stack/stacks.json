{
  "plugin": "rails-stack",
  "stacks": [
    {
      "id": "rails",
      "name": "Rails",
      "all": [
        { "file": "Gemfile" },
        { "file": "config/application.rb" }
      ],
      "descriptor": {
        "runner_prefix": ["bundle", "exec"],
        "setup_section": "setup/rails.md",
        "security": {
            "checklist": "security/rails.md",
            "cases": "security/boundary-cases.json",
            "scanners": [
              "brakeman",
              "bundler-audit",
              "importmap audit"
            ],
            "boundary_text": [
              {
                "boundary": "public-route",
                "pattern": "\\ballow_unauthenticated_access\\b"
              },
              {
                "boundary": "upload-import",
                "pattern": "\\bhas_(?:one|many)_attached\\b"
              },
              {
                "boundary": "outbound-fetch",
                "pattern": "\\b(?:net::http|faraday|open-uri)\\b"
              },
              {
                "boundary": "secrets",
                "pattern": "\\b(?:encrypts|has_secure_password|rails credentials)\\b"
              },
              {
                "boundary": "input-parsing",
                "pattern": "\\b(?:yaml\\.(?:safe_)?load|marshal\\.load|json\\.parse\\s*\\(?\\s*request\\.(?:body|raw_post))"
              },
              {
                "boundary": "raw-html",
                "pattern": "\\bhtml_safe\\b|\\braw\\(|<%==?\\s*raw\\b|\\brender\\s*\\(?\\s*(?:html|inline):"
              },
              {
                "boundary": "auth-session-role",
                "pattern": "\\b(?:require_authentication|require_login|skip_before_action\\s+:authenticate\\w*|protect_from_forgery|skip_forgery_protection|csrf|cors)\\b|\\bauthenticate_user!"
              },
              {
                "boundary": "redirect-param",
                "pattern": "\\bredirect_to\\s*\\(?\\s*(?:params\\b|session\\[|request\\.referr?er\\b)"
              }
            ],
            "boundary_paths": [
              {
                "boundary": "public-route",
                "pattern": "^app/controllers/(?:public|pages|home)_controller\\.rb$|^config/routes\\.rb$"
              },
              {
                "boundary": "webhook",
                "pattern": "^app/controllers/(?:[^/]+/)*webhooks?/|_webhooks?_controller\\.rb$"
              },
              {
                "boundary": "mcp-tool",
                "pattern": "^app/(?:[^/]+/)*mcp/|^app/controllers/(?:[^/]+/)*mcp(?:_[^/]*)?_controller\\.rb$"
              },
              {
                "boundary": "auth-session-role",
                "pattern": "(?:^|/)(?:sessions|passwords|registrations|omniauth_callbacks|logins?|magic_links|two_factors?|invitations|confirmations|unlocks)_controller\\.rb$|^app/controllers/application_controller\\.rb$|^app/controllers/concerns/auth(?:entication|orization|enticat\\w*)?(?:_[^/]*)?\\.rb$|^app/(?:policies|abilities?)/|^app/models/(?:session|current|role|user)\\.rb$|^config/initializers/(?:devise|session_store)\\.rb$|^lib/(?:[^/]+/)*auth(?:entication|orization|enticat\\w*)?(?:_[^/]*)?(?:/|\\.rb$)|^app/(?:models|services|jobs)/(?:[^/]+/)*(?:auth(?:entication|orization|enticat\\w*)?(?:_[^/]*)?/|(?:[^/]*_)?(?:tokens?|sessions?|auth(?:entication|orization|enticat\\w*)?)(?:_[^/]*)?\\.rb$)"
              },
              {
                "boundary": "upload-import",
                "pattern": "^app/(?:[^/]+/)*uploads?/|^app/(?:models|services|jobs)/(?:[^/]+/)*[^/]*(?:import|intake|upload)[^/]*\\.rb$|^app/controllers/(?:[^/]+/)*(?:uploads?|attachments?|imports?|intakes?)_controller\\.rb$"
              },
              {
                "boundary": "api",
                "pattern": "^app/controllers/api/|^app/controllers/(?:api|webhook)_controller\\.rb$"
              }
            ]
          },
        "tests": {
          "command": ["rspec", "--fail-fast", "--no-color"],
          "glob": "spec/**/*_spec.rb",
          "preflight": ["pg_isready"]
        },
        "layout": {
          "migrations": "db/migrate/",
          "schema": "db/schema.rb",
          "views": "app/views",
          "components": "app/components"
        },
        "boot": {
          "command": "bin/dev",
          "port": 3000,
          "health": "/up",
          "routes": ["/", "/up"]
        },
        "agents": {
          "developer": "rails-stack:rails-developer",
          "migrations": "rails-stack:migration-writer",
          "test_runner": "rails-stack:test-runner",
          "security": "rails-stack:security-auditor",
          "reviewer": "rails-stack:code-reviewer",
          "design_auditor": "rails-stack:design-auditor"
        },
        "deploy": {
          "target": "kamal",
          "artifact": "docker-image",
          "agent": "rails-stack:kamal-configurator"
        },
        "ui": {
          "implementation": "viewcomponent-erb",
          "porter": "design-flow:rails-ui-porter",
          "composer": "design-flow:rails-ui-composer"
        },
        "dangerous_commands": [
          { "pattern": "db:reset", "allowed": "RAILS_ENV=test bin/rails db:reset" }
        ]
      }
    }
  ]
}
