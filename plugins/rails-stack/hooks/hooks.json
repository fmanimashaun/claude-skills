{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -p \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/guard-migrate.sh\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -p \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/lint-ruby.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
