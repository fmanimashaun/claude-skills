#!/usr/bin/env bash
# rails-flow git shim (#1790, the owner's decision on #1793). Put FIRST on PATH for the Bash tool by the SessionStart hook, so it sees
# git's arguments AFTER the shell has expanded them (`$X`, `$(...)`, braces, globs, `eval`, `bash -c`, `xargs`, shell aliases): the
# spelling that defeated a text match is already gone. Everything it does not guard is exec'd with its argv unchanged.
#
# THE RULE: it FAILS CLOSED on anything it cannot judge. It refuses what it recognises as destructive, and it refuses what it cannot read.
#
# REFUSES:
#   add        -A / --all; any pathspec that is not a PLAIN RELATIVE PATH below the root (see PATHSPECS); --pathspec-from-file
#   reset      --hard
#   checkout   -f / --force; the same pathspec rule for `checkout [--] <paths>` (it overwrites the working tree)
#   switch     -f / --force / --discard-changes
#   restore    the same pathspec rule, when it restores the WORKING TREE (`restore --staged <paths>` only unstages, so it passes)
#   clean      -f / --force (clusters too: -fd, -xdf); also a bare `clean` when clean.requireForce is false
#   rm         the repository root, unless --cached or a dry run
#   stash      drop, clear
#   checkout-index  -f / --force            read-tree  --reset together with -u
#   commit | push | merge | rebase | pull | am | cherry-pick | revert   --no-verify (and `commit -n`; `-n` is a dry run or --no-stat elsewhere)
#   config     a WRITE to any key outside CONFIG_WRITE_ALLOWED (an allowlist, #2043), and `--edit`; and, read or write,
#              any `git config` that names core.hooksPath, include.* / includeIf.*, core.fsmonitor, core.sshCommand, or a key that runs a program
#              (diff.external, core.pager, core.editor, sequence.editor, gpg.*program, #2021); a credential.helper or an alias whose value starts with `!`;
#              any section rename (#2027). OUT OF SCOPE (#2021): `git clone --config`/`-c` setting such a key in the NEW clone; that is not the session's
#              repository, and the guarantee moves to the hooks of #1789/#1790.
#   any        -c / --config-env, and the GIT_CONFIG_COUNT/KEY_n/VALUE_n pairs of the environment, setting anything but the ALLOWLIST of (key, value) pairs (#1982): the keys a
#              hermetic fixture sets (maintenance.auto, gc.auto, user.name, user.email, commit.gpgsign, init.defaultBranch, #1999), and the exact hardening overrides shipped code passes (core.fsmonitor=false,
#              core.hooksPath=/dev/null, core.quotePath=false, tag.gpgSign=false, credential.helper= and credential.helper=!gh auth git-credential); GIT_CONFIG_PARAMETERS; GIT_CONFIG_SYSTEM
#              naming anything but /dev/null; GIT_CONFIG_GLOBAL naming anything but /dev/null or a file inside the temp root whose every entry passes the same rule.
# PATHSPECS (add, checkout, restore): a PLAIN RELATIVE PATH only (an absolute path counts as one only when it resolves, physically, to a path
# STRICTLY INSIDE the toplevel of the repository git runs in, #1982: a session in a linked worktree names its files that way). Refused: any other
# absolute path (outside the repository, the root itself in any spelling, above it), pathspec magic (a leading `:`), a glob
# (`*`, `?`, `[`), the repository root in any spelling (`.` at the root, `./.`, `src/..`), a path that leaves the repository.
# ALIASES: resolved with `git config --get alias.<name>` (and the same global options, so `-c alias.p=... p` is seen). Refused: a `!` shell alias
# that mentions git at all (git runs it with its own exec-path first, so the git it calls never reaches this shim), a chain deeper than 5,
# and an alias whose value holds a quote or a backslash (it is not re-split).
# Long options are read by git's UNIQUE-PREFIX rule (`--al` is `--all`, `--ha` is `--hard`, `--no-v` is `--no-verify`). A prefix git would call
# ambiguous is a command git refuses itself, so reading it as the dangerous option only refuses what would not run anyway. A DRY RUN, `-u`,
# an interactive form and an attached option value (`commit -uno` is the mode `no`, not `-n`) are read as git reads them; a `--no-<option>`
# negates the option, so a dry run counts only while it is still in force after the last negation.
# NO EXTERNAL TOOLS: everything here is a bash builtin except the real git, so a PATH with no `tr` or `dirname` cannot make it fail open.
#
# LIMITS, stated (this is a tripwire, not a boundary; the server's branch protection and the #1789 hooks are the backstop):
#   - an absolute /usr/bin/git, `command git`, `env -i git` or a non-shell exec of git never reach this file (PATH is not consulted);
#   - a session where the SessionStart hook did not run (no PATH export), and any process that is not the Bash tool;
#   - a destructive git command that is not in the list above (`branch -D`, `update-ref -d`, `push --force`: the server rules and the
#     #1789 pre-push hook cover pushes);
#   - a `git config` write that names neither key but reaches the same effect through a file this shim cannot see.
# AUDITED ESCAPE: RAILS_FLOW_GIT_OK=1 runs the real git and says so.
# bash 3.2 compatible; needs only bash and git.
set -f
ORIG=("$@")      # the arguments as given

# The shim's own directory, without `dirname`.
self="${BASH_SOURCE[0]}"
case "$self" in */*) self_dir="$(cd "${self%/*}" 2>/dev/null && pwd -P)" ;; *) self_dir="$(pwd -P)" ;; esac

# A shim that has been entered more than this many times in one chain of exec'd processes is a loop (#2003): refuse rather than hang.
depth="${RAILS_FLOW_GIT_SHIM_DEPTH:-0}"
case "$depth" in ''|*[!0-9]*|???????*) depth=0 ;; esac       # not a number, or too long to be one this shim wrote (it counts to 16): zero, quietly (#2005)
if [ "$depth" -ge 16 ]; then
  echo "git-shim (rails-flow): re-entered $depth times: two git shims on PATH are calling each other (#2003). Remove the older rails-flow directory from PATH." >&2
  exit 127
fi

# The real git: the first executable `git` on PATH that is NOT a rails-flow git shim, else /usr/bin/git. After a resume two rails-flow versions' shim directories can both be on PATH
# (1.59.0 and 1.60.0), and a shim that skipped only ITS OWN directory resolved "the real git" to the other shim, which resolved it back: every git call hung (#2003). So every candidate
# is skipped that is a shim directory by name (`*/git-shim`, physically or as written, so a symlink to one counts), or whose file begins with this shim's own header line, which also
# catches a shim installed under another name and every earlier version (they all open with it).
real=""
old_ifs="$IFS"; IFS=:
for d in $PATH; do
  [ -n "$d" ] || d="."
  [ -x "$d/git" ] && [ -f "$d/git" ] || continue          # a regular file: reading a FIFO named git ahead on PATH below would block every git call (#2005)
  dd="$(cd "$d" 2>/dev/null && pwd -P)" || continue
  [ "$dd" = "$self_dir" ] && continue
  case "$dd" in */git-shim) continue ;; esac
  case "$d" in */git-shim|*/git-shim/) continue ;; esac
  first=""; { IFS= read -r -d '' -n 400 first; } < "$d/git" 2>/dev/null
  case "$first" in *"# rails-flow git shim"*) continue ;; esac
  real="$d/git"; break
done
IFS="$old_ifs"
[ -n "$real" ] || { [ -x /usr/bin/git ] && real=/usr/bin/git; }
[ -n "$real" ] || { echo "git-shim (rails-flow): no real git found on PATH" >&2; exit 127; }

if [ "${RAILS_FLOW_GIT_OK:-}" = 1 ]; then
  echo "git-shim (rails-flow): RAILS_FLOW_GIT_OK=1, so this git command is not checked." >&2
  RAILS_FLOW_GIT_SHIM_DEPTH=$((depth + 1)) exec "$real" "${ORIG[@]}"
fi

refuse() {
  {
    printf '%s\n' "git-shim (rails-flow): refused \`git $*\`"
    printf '%s\n' "  rule: $RULE"
    printf '%s\n' "  Do the narrower thing instead: stage named files, restore named paths, or ask the owner. A deliberate exception: RAILS_FLOW_GIT_OK=1 git ... (audited)."
  } >&2
  exit 1
}

# Case-insensitive glob match, switched on only for the one test (a global nocasematch would make `-A` and `-a` the same option).
ci_match() { local r; shopt -s nocasematch; [[ $1 == $2 ]]; r=$?; shopt -u nocasematch; return $r; }

# THE CONFIG A COMMAND MAY CARRY IS AN ALLOWLIST (#1982, the coordinator's decision), in all three forms: GIT_CONFIG_KEY_n/VALUE_n in the environment, `-c` and `--config-env`.
# A denylist could not be completed: a key that runs a program (core.hooksPath, core.fsmonitor, core.sshCommand, core.pager, core.editor, credential.helper,
# gpg.program, diff.external, filter.*.clean, ...) or pulls in a file (include.*) is one more entry nobody listed yet. What passes is judged as a (key, value) PAIR,
# the key case-insensitively (git folds the section and variable names) and EXACTLY (`user.name.x` and `user.namex` are not `user.name`), the value exactly:
#   - the keys a hermetic fixture sets, any value (`scripts/fixture_git.py`: SETTINGS maintenance.auto and gc.auto; IDENTITY user.name, user.email, commit.gpgsign);
#   - the harmless HARDENING overrides shipped code passes, with exactly that value: core.fsmonitor=false, core.hooksPath=/dev/null, core.quotePath=false,
#     tag.gpgSign=false, and an EMPTY credential.helper;
#   - credential.helper=!gh auth git-credential, that exact string only (shipped remote_evidence runs our own gh through it).
# Anything else is refused, aliases included: an alias given on the command line (`-c alias.p=push`) is a key like any other, and core.fsmonitor=<anything but false> or
# core.hooksPath=<anything but /dev/null> is refused. A `-c name` with no `=` is the value "true". `--config-env name=VAR` is judged with the value VAR holds.
# core.hooksPath=/dev/null switches the git hooks (the #1789 pre-commit and pre-push guards) OFF for the command that carries it, so it is admitted ONLY for a command that runs no
# pre-commit or pre-push hook. The rule is that and nothing wider; the list below (HOOK_FREE) is every subcommand admitted, and each is read-only or touches no commit or push: status, diff,
# diff-index, diff-tree, log, show, shortlog, ls-files, ls-tree, ls-remote, rev-parse, rev-list, merge-base, for-each-ref, cat-file, show-ref, symbolic-ref, describe, blame, var, fetch, config,
# remote, branch, tag, init, check-ignore, name-rev, count-objects, grep. Adding a name to it needs the same justification (it must not run the pre-commit or pre-push hook).
# Accepted cost (the coordinator's ruling on #1994): `scripts/wip_commit.py` commits with `-c core.hooksPath=/dev/null` and is therefore refused when run by hand from the Bash tool; its
# normal path, the Stop hook, runs without the shim on PATH and is unaffected, and an agent turning hooks off by hand is what this rule is for.
# How it works: CFG_PAIR_ALLOWED sets HOOKS_OFF when it admits the pair, `decide` refuses the command unless its subcommand is on HOOK_FREE, and a GIT_CONFIG_GLOBAL file may not carry it at
# all (#1994: `git -c core.hooksPath=/dev/null commit` and `push` skipped the guards, and so did a global file naming it).
HOOKS_OFF=0
HOOK_FREE=" status diff diff-index diff-tree log show shortlog ls-files ls-tree ls-remote rev-parse rev-list merge-base for-each-ref cat-file show-ref symbolic-ref describe blame var fetch config remote branch tag init check-ignore name-rev count-objects grep "
CFG_ALLOWED() {
  ci_match "$1" "maintenance.auto" || ci_match "$1" "gc.auto" || ci_match "$1" "user.name" || ci_match "$1" "user.email" || ci_match "$1" "commit.gpgsign" || ci_match "$1" "init.defaultbranch"
}
CFG_PAIR_ALLOWED() {      # $1 key, $2 value
  CFG_ALLOWED "$1" && return 0
  ci_match "$1" "core.fsmonitor" && [ "$2" = false ] && return 0
  ci_match "$1" "core.hookspath" && [ "$2" = /dev/null ] && { HOOKS_OFF=1; return 0; }
  ci_match "$1" "core.quotepath" && [ "$2" = false ] && return 0
  ci_match "$1" "tag.gpgsign" && [ "$2" = false ] && return 0
  ci_match "$1" "credential.helper" && { [ -z "$2" ] || [ "$2" = '!gh auth git-credential' ]; } && return 0
  return 1
}
CFG_ALLOWED_LIST="maintenance.auto, gc.auto, user.name, user.email, commit.gpgsign, init.defaultBranch (any value) or core.fsmonitor=false, core.hooksPath=/dev/null, core.quotePath=false, tag.gpgSign=false, credential.helper= (empty), credential.helper=!gh auth git-credential"
cfg_arg_ok() {            # `-c name=value`, or `-c name` (the value "true")
  case "$1" in *=*) CFG_PAIR_ALLOWED "${1%%=*}" "${1#*=}" ;; *) CFG_PAIR_ALLOWED "$1" true ;; esac
}
cfg_env_arg_ok() {        # `--config-env name=VAR`: the value is what VAR holds (an unset VAR is an error in git, and refused here)
  local key var
  case "$1" in *=*) ;; *) return 1 ;; esac
  key="${1%%=*}"; var="${1#*=}"
  case "$var" in ''|[0-9]*|*[!A-Za-z0-9_]*) return 1 ;; esac
  [ "${!var+x}" = x ] || return 1
  CFG_PAIR_ALLOWED "$key" "${!var}"
}

# A directory physically (`cd ... && pwd -P`): macOS /var is /private/var, and a symlink resolves to what it points at.
phys() { ( cd "$1" 2>/dev/null && pwd -P ); }

# THE TEMP ROOT every exemption is judged against (#1982, decision (b)): TMPDIR, which must be SET (an unset one is refused, not defaulted), physically resolved, and must not be `/`
# or HOME, and must not contain the session's project (CLAUDE_SESSION_PROJECT_TOP, recorded by the SessionStart hook under a name fixtures do not scrub, which GIT_* and RAILS_FLOW_* are; unset means no temp root): a crafted `TMPDIR=/` or `TMPDIR=$HOME`, or one
# over the project, cannot widen an exemption to the project. Sets TP and PP (the physical project).
TP=""; PP=""; TP_DONE=0
temp_root_ok() {
  [ "$TP_DONE" = 1 ] && { [ -n "$TP" ]; return; }
  TP_DONE=1
  local hp tp pp
  [ -n "${TMPDIR:-}" ] || return 1
  tp="$(phys "$TMPDIR")"; [ -n "$tp" ] && [ "$tp" != / ] || return 1
  if [ -n "${HOME:-}" ]; then hp="$(phys "$HOME")"; [ "$hp" != "$tp" ] || return 1; fi
  [ -n "${CLAUDE_SESSION_PROJECT_TOP:-}" ] || return 1
  pp="$(phys "$CLAUDE_SESSION_PROJECT_TOP")"; [ -n "$pp" ] || return 1
  case "$pp/" in "$tp"/*) return 1 ;; esac
  TP="$tp"; PP="$pp"; return 0
}

# GIT_CONFIG_GLOBAL may be /dev/null, or a REGULAR FILE physically strictly inside the temp root (a hermetic fixture's own config), whose every entry passes the same pair
# rule (read with the real git: an include.path entry, a line it cannot split into key=value, anything not allowlisted is refused).
global_file_ok() {
  local f="$1" dir base phys_dir line
  [ -f "$f" ] && [ ! -L "$f" ] || return 1          # a symlink is not resolved here, so it is refused
  temp_root_ok || return 1
  base="${f##*/}"; dir="${f%/*}"; [ "$dir" = "$f" ] && dir=.; [ -n "$dir" ] || dir=/
  phys_dir="$(phys "$dir")"; [ -n "$phys_dir" ] || return 1
  case "$phys_dir/$base" in "$TP"/?*) ;; *) return 1 ;; esac
  while IFS= read -r line; do
    case "$line" in *=*) ;; *) return 1 ;; esac
    ci_match "${line%%=*}" "core.hookspath" && return 1       # a global file may not switch the hooks off, even to /dev/null
    CFG_PAIR_ALLOWED "${line%%=*}" "${line#*=}" || return 1
  done < <("$real" config --file "$f" --list 2>/dev/null)
  return 0
}

# GIT_CONFIG_* in the environment: READ the pairs and admit only the allowlisted ones (#1982). A hermetic fixture exports GIT_CONFIG_COUNT/KEY_n/VALUE_n
# (maintenance.auto and gc.auto) to keep its git independent of the host, and refusing every GIT_CONFIG_* variable on sight refused `git init` itself in
# each of them. Anything this shim cannot read stays refused: GIT_CONFIG_PARAMETERS, a GLOBAL file outside the rule above, a non-/dev/null SYSTEM file, an
# unknown GIT_CONFIG_* name, a count that is not a plain number, and any pair that is not allowlisted.
for v in $(compgen -e GIT_CONFIG_); do
  case "$v" in
    GIT_CONFIG_NOSYSTEM|GIT_CONFIG_COUNT|GIT_CONFIG_KEY_*|GIT_CONFIG_VALUE_*) ;;      # a switch that only turns the system file OFF; the pairs, read below
    GIT_CONFIG_GLOBAL)
      [ "${!v}" = /dev/null ] || global_file_ok "${!v}" || { RULE="$v names a config file (${!v}) this shim cannot accept: only /dev/null, or a file inside the temp root whose every entry is allowlisted"; refuse "${ORIG[@]}"; } ;;
    GIT_CONFIG_SYSTEM)
      [ "${!v}" = /dev/null ] || { RULE="$v names a config file (${!v}) this shim cannot read: only /dev/null passes"; refuse "${ORIG[@]}"; } ;;
    *) RULE="$v is set: it can define aliases, core.hooksPath and includes that this shim cannot read"; refuse "${ORIG[@]}" ;;
  esac
done
cfg_count="${GIT_CONFIG_COUNT:-0}"
case "$cfg_count" in
  ''|*[!0-9]*|??????*) RULE="GIT_CONFIG_COUNT ($cfg_count) is not a plain number of pairs this shim can read"; refuse "${ORIG[@]}" ;;
esac
cfg_i=0
while [ "$cfg_i" -lt "$cfg_count" ]; do
  cfg_var="GIT_CONFIG_KEY_$cfg_i"; cfg_key="${!cfg_var:-}"; cfg_vv="GIT_CONFIG_VALUE_$cfg_i"
  if [ "${!cfg_vv+x}" != x ] || ! CFG_PAIR_ALLOWED "$cfg_key" "${!cfg_vv}"; then
    RULE="$cfg_var=$cfg_key: only $CFG_ALLOWED_LIST may be set in the environment (any other pair can run a program or pull in a file)"; refuse "${ORIG[@]}"
  fi
  cfg_i=$((cfg_i + 1))
done

# A path relative to the repository top: `norm <prefix> <path>` prints it ("" for the root, "OUT" when it leaves the repository).
norm() {
  local p="$1$2" part out="" depth=0 parts IFS=/
  parts=()
  for part in $p; do
    case "$part" in
      ""|.) ;;
      ..) if [ "$depth" -gt 0 ]; then depth=$((depth - 1)); unset "parts[$depth]"; else printf 'OUT'; return; fi ;;
      *) parts[$depth]="$part"; depth=$((depth + 1)) ;;
    esac
  done
  [ "$depth" -gt 0 ] && out="${parts[*]}"
  printf '%s' "$out"
}

TOP=""; PREFIX=""; HAVE_TOP=0
find_top() {
  [ "$HAVE_TOP" = 1 ] && return 0
  HAVE_TOP=1
  TOP="$("$real" "${GLOBALS[@]}" rev-parse --show-toplevel 2>/dev/null)" || TOP=""
  PREFIX="$("$real" "${GLOBALS[@]}" rev-parse --show-prefix 2>/dev/null)" || PREFIX=""
}

# THE FIXTURE EXEMPTION (#1982, the coordinator's decision (b)). A hermetic fixture builds its own temp repository and stages it whole (`git add -A`),
# which the rules above refuse everywhere, so every selftest that does it failed when run from the Claude Code Bash tool (the shim is first on PATH there). `fixture_git.run`
# names the repository exactly, with GIT_DIR and GIT_WORK_TREE. The exemption holds ONLY when ALL of these are true, each resolved PHYSICALLY:
#   1. GIT_DIR and GIT_WORK_TREE are both set, and both lie STRICTLY INSIDE the temp root (one inside and one outside refuses);
#   2. the temp root is valid (`temp_root_ok`: TMPDIR set, not `/` or HOME, not containing the session's project);
#   3. the work tree is NOT the session's project toplevel and NOT an ancestor of it (also implied by `temp_root_ok`, which refuses a temp root that contains the project: a work
#      tree strictly inside the temp root that held the project would have to be inside it, so the check below is defence in depth and has no mutant of its own).
# A repository the SessionStart hook marked as the session's own: `claude-session-project` in its git dir (or, for a linked worktree, in its common dir). Read from the
# repository GIT_DIR names, not from the environment, so an inline `CLAUDE_SESSION_PROJECT_TOP=/usr` or a crafted TMPDIR cannot turn the project into "a fixture" (the security
# review of #1994 reproduced that: a wrong but existing marker value let `git reset --hard` through on the real project).
session_repo_marked() {
  local gd="$1" c
  [ -f "$gd/claude-session-project" ] && return 0
  if [ -f "$gd/commondir" ]; then
    IFS= read -r c < "$gd/commondir"; case "$c" in /*) ;; *) c="$gd/$c" ;; esac
    c="$(phys "$c")"; [ -n "$c" ] && [ -f "$c/claude-session-project" ] && return 0
  fi
  return 1
}

# The identity file: in the repository's git dir, or, for a LINKED worktree of a fixture, in its common dir (the same two places the session marker is read). A downstream project's
# spec helpers write it right after `git init` (`plugins/rails-flow/reference/downstream-spec-fixtures.md`, #1999); `fixture_git.init` writes it for ours. It is a file in the git dir, not
# an environment variable, because the environment is the caller's: an inline assignment would turn any repository into a fixture.
fixture_marked() {
  local gd="$1" c
  [ -f "$gd/rails-flow-fixture" ] && return 0
  if [ -f "$gd/commondir" ]; then
    IFS= read -r c < "$gd/commondir"; case "$c" in /*) ;; *) c="$gd/$c" ;; esac
    c="$(phys "$c")"; [ -n "$c" ] && [ -f "$c/rails-flow-fixture" ] && return 0
  fi
  return 1
}

FIX_DONE=0; FIX_RC=1
fixture_repo() {
  [ "$FIX_DONE" = 1 ] && return "$FIX_RC"
  FIX_DONE=1
  local gd wt v g rp l1 l2 cwd_mode
  # TWO MODES, never a mix (#1999). ENV mode: GIT_DIR and GIT_WORK_TREE are BOTH set (`fixture_git.run`). CWD mode: BOTH are unset and the repository is the one the process's own
  # directory (or a `-C <dir>`) is in, which is how a downstream project's spec helpers run git (`Open3.capture2e(env, "git", ..., chdir: repo)`). One set and not the other is refused.
  # Either way the repository judged is the one the REAL git will use (asked below), so a mode cannot name one repository and run on another.
  cwd_mode=0
  if [ -z "${GIT_DIR:-}" ] && [ -z "${GIT_WORK_TREE:-}" ]; then cwd_mode=1
  else [ -n "${GIT_DIR:-}" ] && [ -n "${GIT_WORK_TREE:-}" ] || return 1
  fi
  # Things git honours INSTEAD OF (or beside) GIT_DIR and GIT_WORK_TREE: a command-line --git-dir/--work-tree/-C/--namespace beats the environment, and an index, an object store, a
  # common dir or a namespace named in the environment point git at another repository's state while a decoy sits in GIT_DIR (#1994).
  for v in GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR GIT_NAMESPACE; do
    [ "${!v+x}" = x ] && return 1
  done
  for g in "${GLOBALS[@]}"; do
    case "$g" in --git-dir|--git-dir=*|--work-tree|--work-tree=*|--namespace|--namespace=*) return 1 ;; esac
    # `-C <dir>` beats nothing in CWD mode (there is no GIT_DIR for it to override): the real git is asked about the repository it leads to. In ENV mode it would move git's directory
    # while GIT_DIR names a decoy, so it stays refused there.
    [ "$g" = -C ] && [ "$cwd_mode" = 0 ] && return 1
  done
  temp_root_ok || return 1
  # Judge the repository git WILL use, asked of the real git under the real arguments and environment, not the variables read off the environment.
  rp="$("$real" "${GLOBALS[@]}" rev-parse --absolute-git-dir --show-toplevel 2>/dev/null)" || return 1
  { IFS= read -r l1; IFS= read -r l2; } <<< "$rp"
  [ -n "$l1" ] && [ -n "$l2" ] || return 1
  gd="$(phys "$l1")"; wt="$(phys "$l2")"
  [ -n "$wt" ] && [ -n "$gd" ] || return 1
  case "$wt" in "$TP"/?*) ;; *) return 1 ;; esac
  case "$gd" in "$TP"/?*) ;; *) return 1 ;; esac
  case "$PP/" in "$wt"/*) return 1 ;; esac      # the work tree IS the project or contains it
  session_repo_marked "$gd" && return 1          # the repository named is the session's own, whatever the environment says
  fixture_marked "$gd" || return 1               # POSITIVE identity: only a repository that carries `rails-flow-fixture` is a fixture (a standalone repo inside the temp root is not)
  FIX_RC=0; return 0
}

# `git config core.hooksPath <value>` (or `--local core.hooksPath <value>`) in a FIXTURE repository, judged by `fixture_repo` (marked, inside the temp root, not the session's project, no flag or variable
# that redirects git). Why this one write is safe: it lands in the fixture's OWN `.git/config`, so the hooks it can switch off are the fixture's, never the session's (#1789); the repository is the
# one the real git will use, so `-C`, `--git-dir` and a decoy in the environment cannot aim it at the project. Anything else about `config` stays refused here: every other key, `--global`,
# `--system`, `--file`/`-f`, `--blob`, `--worktree`, an unset, a value that looks like an option, and extra arguments (a project's spec that needs more asks for it with an adversary pass).
# #2043 — `git config` WRITES ARE AN ALLOWLIST, the same model as the `-c` allowlist above. Blocking program-running keys one by one never
# closed the class (#2021 named eight; a0 measured a dozen more: pager.*, core.askpass, core.gitProxy, diff.*.textconv, filter.*.clean, merge.*.driver,
# *tool.*.cmd, web.browser, uploadpack.packObjectsHook, ...), so a write is let through only for the keys a session sets in ordinary work, measured
# from our own scripts and the downstream fixtures (commit.gpgsign; core.hooksPath only in a fixture, via `fixture_hooks_config`). alias.* and the credential
# helper keys are listed because their dangerous values are refused by their own rules above (a `!` alias; a `!` or `/` helper). Reads are not judged here.
CONFIG_WRITE_ALLOWED="user.name user.email commit.gpgsign tag.gpgsign init.defaultbranch maintenance.auto gc.auto core.quotepath core.autocrlf pull.rebase pull.ff push.default push.autosetupremote fetch.prune rerere.enabled merge.conflictstyle color.ui branch.*.remote branch.*.merge branch.*.rebase remote.*.url remote.*.fetch alias.* credential.helper credential.*.helper"

# config_write_key <config arguments...>: sets CFG_WRITE (1 when the command writes) and CFG_KEY (the key it writes, empty when it cannot name one).
# A write is a write subcommand (set, unset, rename-section, remove-section, edit), a write flag in any unique-prefix spelling git accepts, or the
# old two-positional form `key value` with no read flag. Option values (`--file x`, `--type x`, ...) are skipped so they are never read as the key.
config_write_key() {
  CFG_WRITE=0; CFG_KEY=""; CLUSTER=0
  local a pos=() read=0 skip=0 f known endopts=0
  case "${1:-}" in
    set|unset|rename-section|remove-section|edit) CFG_WRITE=1; shift ;;
    get|list) return 0 ;;
  esac
  for a in "$@"; do
    if [ "$skip" = 1 ]; then skip=0; continue; fi
    if [ "$endopts" = 1 ]; then pos+=("$a"); continue; fi
    case "$a" in
      --) endopts=1; continue ;;
      -f|--file|--blob|--type|--default|--comment|--value|--url) skip=1; continue ;;
      -e) CFG_WRITE=1; continue ;;
      -l) read=1; continue ;;
      # A COMBINED short cluster (`-ze` = -z -e, `-zf FILE`, an attached `-fFILE`) is parsed by git letter by letter, so this shim cannot tell
      # which argument is the key or whether it edits: treat it as an unjudgeable write, which the allowlist refuses (the commit security
      # review of #2043: `git config -ze` opened the editor and `-zf user.name pager.log x` wrote pager.log past the key check).
      -[!-]?*) CFG_WRITE=1; CFG_KEY=""; CLUSTER=1; continue ;;
      --*=*) continue ;;
      --*)
        for f in --add --replace-all --unset --unset-all --remove-section --rename-section --edit; do
          case "$f" in "$a"?*|"$a") [ "${#a}" -ge 4 ] && CFG_WRITE=1 ;; esac
        done
        for f in --get --get-all --get-regexp --get-urlmatch --get-color --get-colorbool --list; do
          [ "$a" = "$f" ] && read=1
        done
        # ONLY EXACT, KNOWN no-value flags are understood. git reads a long option by its unique prefix, so an abbreviation of a VALUE option
        # (`--fil x` = `--file x`, `--comm x` = `--comment x`) takes the next argument as its value and moves the key (the second commit security
        # review of #2043: `--fil user.name pager.log x` wrote pager.log past the key check). Any long option not on this list makes a write unjudgeable.
        known=0
        for f in --global --system --local --worktree --includes --no-includes --null --name-only --show-origin --show-scope --bool --int \
                 --bool-or-int --path --expiry-date --fixed-value --append --all --no-type --get --get-all --get-regexp --get-urlmatch --get-color \
                 --get-colorbool --list --add --replace-all --unset --unset-all --remove-section --rename-section --edit; do
          [ "$a" = "$f" ] && known=1
        done
        [ "$known" = 1 ] || CLUSTER=1
        continue ;;
      -*) continue ;;
    esac
    pos+=("$a")
  done
  [ "$read" = 1 ] && [ "$CFG_WRITE" = 0 ] && return 0
  [ "${#pos[@]}" -ge 2 ] && CFG_WRITE=1
  [ "$CFG_WRITE" = 1 ] && [ "${CLUSTER:-0}" = 0 ] && CFG_KEY="${pos[0]:-}"
  return 0
}

# config_key_allowed <key>: is this key on CONFIG_WRITE_ALLOWED (case-insensitive; `*` is one dotted segment or more)?
config_key_allowed() {
  local k="$1" pat
  [ -n "$k" ] || return 1
  for pat in $CONFIG_WRITE_ALLOWED; do
    ci_match "$k" "$pat" && return 0
  done
  return 1
}

fixture_hooks_config() {
  local key val
  case "$#" in
    2) key="$1"; val="$2" ;;
    3) [ "$1" = --local ] || return 1; key="$2"; val="$3" ;;
    *) return 1 ;;
  esac
  ci_match "$key" "core.hookspath" || return 1
  case "$val" in ''|-*) return 1 ;; esac
  fixture_repo
}

# Is this pathspec the repository root, in any spelling? (used by `rm`, which may name a glob)
is_root_path() {
  local p="$1"
  find_top
  [ -n "$TOP" ] || return 0          # cannot find the root: cannot judge, so treat it as the root
  case "$p" in "*"|"**") return 0 ;; */"*"|*/"**") p="${p%/*}" ;; esac
  [ "$(norm "$PREFIX" "$p")" = "" ]
}

# An absolute pathspec, made relative to the toplevel when it names a path STRICTLY INSIDE it (#1982). Prints it (top-relative, never empty) or nothing.
# The directory part is resolved PHYSICALLY (`cd ... && pwd -P`) because git reports the toplevel physically and a temp directory is often a symlink
# (/tmp, /var on macOS); a path whose directory does not exist, whose last component is `.` or `..`, or that does not sit under `$TOP/`, prints nothing.
abs_inside() {
  local p="$1" dir base phys
  while [ "${#p}" -gt 1 ] && [ "${p%/}" != "$p" ]; do p="${p%/}"; done    # trailing slashes: `/r/dir/` is `/r/dir`
  base="${p##*/}"; dir="${p%/*}"; [ -n "$dir" ] || dir=/
  case "$base" in ""|.|..) return 0 ;; esac
  phys="$(cd "$dir" 2>/dev/null && pwd -P)" || return 0
  [ -n "$phys" ] || return 0
  case "$phys" in /) phys="" ;; esac
  find_top
  [ -n "$TOP" ] || return 0
  case "$phys/$base" in "$TOP"/?*) printf '%s' "${phys#"$TOP"}/$base" | { IFS= read -r x; printf '%s' "${x#/}"; } ;; esac
}

# Is this pathspec a PLAIN RELATIVE PATH below the root? Sets BADWHY and returns 1 when it is not.
BADWHY=""
plain_path() {
  local p="$1" n rel
  case "$p" in
    "") BADWHY="an empty pathspec"; return 1 ;;
    :*) BADWHY="pathspec magic ($p) cannot be judged"; return 1 ;;
    *"*"*|*"?"*|*"["*) BADWHY="a glob ($p) can match the whole tree"; return 1 ;;
  esac
  find_top
  if [ -z "$TOP" ]; then BADWHY="the repository root could not be found"; return 1; fi
  case "$p" in
    /*)
      rel="$(abs_inside "$p")"
      if [ -z "$rel" ]; then BADWHY="an absolute path ($p) that is not strictly inside the repository ($TOP) cannot be judged"; return 1; fi
      n="$(norm "" "$rel")"
      if [ "$n" = "OUT" ] || [ -z "$n" ]; then BADWHY="$p leaves the repository or is its root"; return 1; fi
      return 0 ;;
  esac
  n="$(norm "$PREFIX" "$p")"
  if [ "$n" = "OUT" ]; then BADWHY="$p leaves the repository"; return 1; fi
  if [ -z "$n" ]; then BADWHY="$p is the repository root"; return 1; fi
  return 0
}

CANON_long() {   # per subcommand: the long options this shim cares about
  case "$1" in
    add) echo "all dry-run update patch interactive" ;;
    reset) echo "hard" ;;
    checkout) echo "force patch" ;;
    switch) echo "force discard-changes" ;;
    restore) echo "staged worktree patch" ;;
    clean) echo "force dry-run interactive" ;;
    rm) echo "cached dry-run" ;;
    checkout-index) echo "force" ;;
    read-tree) echo "reset" ;;
    commit|push|merge|rebase|pull|am|cherry-pick|revert) echo "no-verify" ;;
  esac
}
CANON_short() {  # "<char>=<canonical> ..."
  case "$1" in
    add) echo "A=all n=dry-run u=update p=patch i=interactive" ;;
    checkout) echo "f=force p=patch" ;;
    switch) echo "f=force" ;;
    restore) echo "S=staged W=worktree p=patch" ;;
    clean) echo "f=force n=dry-run i=interactive" ;;
    rm) echo "n=dry-run" ;;
    checkout-index) echo "f=force" ;;
    read-tree) echo "u=update" ;;
    commit) echo "n=no-verify" ;;
  esac
}
VALUED_short() {   # short options whose value is the next word (or the rest of the cluster)
  case "$1" in
    commit) echo "mFCct" ;; push) echo "o" ;; merge) echo "mFsX" ;; rebase) echo "sXxC" ;; pull) echo "sXo" ;;
    am) echo "p" ;; cherry-pick) echo "mXs" ;; revert) echo "mXs" ;;
    checkout) echo "bB" ;; switch) echo "cC" ;; restore) echo "s" ;; clean) echo "e" ;;
  esac
}
ATTACHED_short() {  # short options whose value, if any, is ATTACHED (`commit -uno`, `commit -S<keyid>`): the rest of the cluster is the value
  case "$1" in
    commit) echo "uS" ;; merge) echo "S" ;; pull) echo "S" ;; rebase) echo "S" ;; cherry-pick) echo "S" ;; revert) echo "S" ;; am) echo "S" ;;
  esac
}
VALUED_long() {
  case "$1" in
    commit) echo "message file reuse-message reedit-message fixup squash author date template cleanup trailer pathspec-from-file" ;;
    push) echo "push-option repo receive-pack exec" ;;
    merge) echo "message file strategy strategy-option into-name" ;;
    pull) echo "strategy strategy-option upload-pack" ;;
    rebase) echo "strategy strategy-option exec onto" ;;
    am) echo "directory exclude include reject patch-format" ;;
    cherry-pick|revert) echo "mainline strategy strategy-option" ;;
    add) echo "chmod pathspec-from-file" ;;
    reset) echo "pathspec-from-file" ;;
    checkout) echo "orphan conflict pathspec-from-file" ;;
    switch) echo "orphan conflict create force-create" ;;
    restore) echo "source pathspec-from-file" ;;
    clean) echo "exclude" ;;
  esac
}

SEEN=" "          # canonical flags in force, space-delimited
PATHS=()          # non-option arguments (after `--` too)
PFILE=0           # a --pathspec-from-file was given

# analyse <sub> <args...>: fills SEEN, PATHS, PFILE.
analyse() {
  local sub="$1"; shift
  local args=("$@") n=$# i=0 a name val c hit seen_dd=0 k pair ch rest longs shorts vshort vlong ashort
  longs="$(CANON_long "$sub")"; shorts="$(CANON_short "$sub")"; vshort="$(VALUED_short "$sub")"; vlong="$(VALUED_long "$sub")"; ashort="$(ATTACHED_short "$sub")"
  SEEN=" "; PATHS=(); PFILE=0
  while [ "$i" -lt "$n" ]; do
    a="${args[$i]}"; i=$((i + 1))
    if [ "$seen_dd" = 1 ]; then PATHS[${#PATHS[@]}]="$a"; continue; fi
    case "$a" in
      --) seen_dd=1 ;;
      --*)
        name="${a#--}"; val=""; case "$name" in *=*) val="${name#*=}"; name="${name%%=*}" ;; esac
        hit=0
        for c in $longs; do
          case "$c" in "$name"*) SEEN="$SEEN$c "; hit=1 ;; esac
        done
        if [ "$hit" = 0 ]; then
          # `--no-<option>` negates the option, so it is no longer in force; `--verify` negates `--no-verify`
          case "$name" in
            no-?*) rest="${name#no-}"; for c in $longs; do case "$c" in "$rest"*) SEEN="${SEEN/ $c / }"; hit=1 ;; esac; done ;;
            verify) SEEN="${SEEN/ no-verify / }"; hit=1 ;;
          esac
        fi
        case "pathspec-from-file" in "$name"*) [ -n "$name" ] && PFILE=1 ;; esac
        if [ "$hit" = 0 ] && [ "$a" = "--$name" ]; then
          for c in $vlong; do
            case "$c" in "$name"*) [ "$i" -lt "$n" ] && i=$((i + 1)); break ;; esac
          done
        fi ;;
      -?*)
        rest="${a#-}"; k=0
        while [ "$k" -lt "${#rest}" ]; do
          ch="${rest:$k:1}"; k=$((k + 1))
          case "$ashort" in *"$ch"*) break ;; esac          # the rest of the cluster is this option's attached value
          case "$vshort" in *"$ch"*) [ "$k" -ge "${#rest}" ] && [ "$i" -lt "$n" ] && i=$((i + 1)); break ;; esac
          for pair in $shorts; do
            [ "${pair%%=*}" = "$ch" ] && SEEN="$SEEN${pair#*=} "
          done
        done ;;
      *) PATHS[${#PATHS[@]}]="$a" ;;
    esac
  done
}
seen() { case "$SEEN" in *" $1 "*) return 0 ;; esac; return 1; }

# Every pathspec must be a plain relative path (add, checkout, restore). Sets RULE and returns 1 when one is not.
paths_plain() {
  local p
  if [ "$PFILE" = 1 ]; then RULE="--pathspec-from-file cannot be judged (its file may name the whole tree)"; return 1; fi
  for p in "${PATHS[@]}"; do
    plain_path "$p" || { RULE="$1: $BADWHY (name plain relative paths)"; return 1; }
  done
  return 0
}

# Decide one (possibly alias-expanded) command. $1.. is the subcommand and its arguments; GLOBALS is set.
decide() {
  local sub="$1"; shift
  if [ "$HOOKS_OFF" = 1 ]; then
    case "$HOOK_FREE" in *" $sub "*) ;; *) RULE="core.hooksPath=/dev/null switches the #1789 git hooks off, so only a command that runs no hook may carry it (git $sub can)"; return 1 ;; esac
  fi
  case "$sub" in
    add|reset|checkout|switch|restore|clean|rm|stash|checkout-index|read-tree|config|commit|push|merge|rebase|pull|am|cherry-pick|revert) ;;
    *) return 0 ;;
  esac
  # THE FIXTURE EXEMPTION (above) covers staging (`add`) and, since #1999, ONE local config write: `core.hooksPath` in the fixture repository's own config (a project's spec installs
  # its own hooks there). `reset --hard`, `clean`, forced checkout and the other working-tree rules, and every other rule about hooks, config and `--no-verify`, are NOT exempt in a
  # fixture: widening it waits for an adversary pass (the coordinator's ruling on #1994).
  case "$sub" in
    add) fixture_repo && return 0 ;;
    config) fixture_hooks_config "$@" && return 0 ;;        # #1999: ONE local config write, in a marked fixture only (see `fixture_hooks_config`)
  esac
  analyse "$sub" "$@"
  case "$sub" in
    add)
      seen dry-run && return 0
      if seen all; then RULE="git add --all stages every change in the tree, including strays (stage named files)"; return 1; fi
      seen update && return 0; seen patch && return 0; seen interactive && return 0
      paths_plain "git add" || return 1 ;;
    reset)
      if seen hard; then RULE="git reset --hard destroys uncommitted work"; return 1; fi ;;
    checkout)
      if seen force; then RULE="git checkout --force discards local changes"; return 1; fi
      seen patch && return 0
      paths_plain "git checkout" || return 1 ;;
    switch)
      if seen force || seen discard-changes; then RULE="git switch --force/--discard-changes discards local changes"; return 1; fi ;;
    restore)
      seen patch && return 0
      if seen worktree || ! seen staged; then paths_plain "git restore (the working tree; restore --staged only unstages)" || return 1; fi ;;
    clean)
      seen dry-run && return 0
      if seen force; then RULE="git clean --force deletes untracked files"; return 1; fi
      if ! seen interactive && [ "$("$real" "${GLOBALS[@]}" config --type=bool --get clean.requireForce 2>/dev/null)" = "false" ]; then
        RULE="git clean with clean.requireForce=false deletes untracked files without --force"; return 1
      fi ;;
    rm)
      seen cached && return 0; seen dry-run && return 0
      local p
      for p in "${PATHS[@]}"; do
        if is_root_path "$p"; then RULE="git rm of the repository root deletes the whole tree (name paths, or use --cached)"; return 1; fi
      done ;;
    stash)
      case "${PATHS[0]:-}" in drop|clear) RULE="git stash ${PATHS[0]} destroys saved work"; return 1 ;; esac ;;
    checkout-index)
      if seen force; then RULE="git checkout-index --force overwrites the working tree"; return 1; fi ;;
    read-tree)
      if seen reset && seen update; then RULE="git read-tree --reset -u overwrites the working tree"; return 1; fi ;;
    config)
      local x alias_key=0 shell_value=0 section_move=0 cred_key=0 path_value=0
      for x in "$@"; do
        if ci_match "$x" "*core.hookspath*" || ci_match "$x" "*include.path*" || ci_match "$x" "*includeif.*" || ci_match "$x" "*core.fsmonitor*" || ci_match "$x" "*core.sshcommand*"; then
          RULE="git config naming core.hooksPath, include.*, core.fsmonitor or core.sshCommand can switch the #1789 git hooks off"; return 1
        fi
        # (#2021's per-key list of program-running keys is superseded by the write ALLOWLIST below, #2043: a write to any of them is refused there.)
        ci_match "$x" "credential.*helper" && cred_key=1
        ci_match "$x" "alias.*" && alias_key=1
        # A SECTION RENAME is refused OUTRIGHT, whatever the target (#2026): renamed onto `alias` it made a shell alias (#2023), and onto `core` or
        # `include` it set `core.hooksPath`, `core.fsmonitor`, `core.sshCommand` or `include.path` past the per-key rules above (a0, measured), because a
        # rename never names the key it creates.
        # Exact spelling only: an abbreviation (`--ren`) is an unknown long option, which makes the write unjudgeable below (#2043).
        [ "$x" = --rename-section ] && section_move=1
        case "${x#"${x%%[! ]*}"}" in "!"*) shell_value=1 ;; "/"*) path_value=1 ;; esac      # the value, leading spaces aside, starts with `!` (a shell command) or `/` (a program path)
      done
      # The `rename-section` SUBCOMMAND (newer gits) is the same rename, spelled as the first word.
      [ "${1:-}" = rename-section ] && section_move=1
      if [ "$section_move" = 1 ]; then
        RULE="git config renaming a section can create core.hooksPath, include.path or a shell alias without naming them"; return 1
      fi
      # #2021: git runs a credential helper three ways. A value starting with `!` is a SHELL command; an ABSOLUTE PATH is a program run as given
      # (a0, review of #2042: `credential.helper /abs/script` ran with the real git first on its PATH); anything else is git's own
      # `git credential-<name>` (`store`, `cache`, `osxkeychain`), which is allowed. The first two are refused. Any other argument starting with
      # `/` (a `--file /path`) also counts, so `git config --file /x credential.helper store` is refused too: an accepted cost on a rare command.
      if [ "$cred_key" = 1 ] && { [ "$shell_value" = 1 ] || [ "$path_value" = 1 ]; }; then
        RULE="git config writing a credential.helper that is a shell command (!) or a program path (/) runs a program this shim cannot see"; return 1
      fi
      # #2043: everything above refuses a named danger; this lets a WRITE through only for a key a session sets in ordinary work.
      config_write_key "$@"
      if [ "$CFG_WRITE" = 1 ]; then
        case "${1:-}" in edit) CFG_KEY="" ;; esac
        for x in "$@"; do case "$x" in -e|--ed|--edi|--edit) CFG_KEY="" ;; esac; done
        if ! config_key_allowed "$CFG_KEY"; then
          RULE="git config writes only the allowlisted keys (${CONFIG_WRITE_ALLOWED// /, }); ${CFG_KEY:-this write} is not one, and editing the file is refused"; return 1
        fi
      fi
      # #2015: a SHELL alias (`!…`) runs any command the next time it is used, and this shim cannot see inside it; writing one is refused, in a
      # fixture too (the exemption above covers only `core.hooksPath`). A plain alias is judged again when it is used, and reading one writes nothing.
      if [ "$alias_key" = 1 ] && [ "$shell_value" = 1 ]; then
        RULE="git config writing a shell alias (a value starting with !) runs a command this shim cannot see"; return 1
      fi ;;
    commit|push|merge|rebase|pull|am|cherry-pick|revert)
      if seen no-verify; then RULE="--no-verify skips the pre-commit and pre-push guards"; return 1; fi ;;
  esac
  return 0
}

GLOBALS=()

# evaluate <git arguments...>: 0 to let the command run, 1 (with RULE set) to refuse it.
evaluate() {
  local ARGV n i a SUB REST val depth=0 rc
  GLOBALS=()
  ARGV=("$@"); n=$#; i=0; SUB=""
  while [ "$i" -lt "$n" ]; do
    a="${ARGV[$i]}"
    case "$a" in
      -C|--git-dir|--work-tree|--namespace|--attr-source|--super-prefix)
        GLOBALS[${#GLOBALS[@]}]="$a"; i=$((i + 1))
        [ "$i" -lt "$n" ] && { GLOBALS[${#GLOBALS[@]}]="${ARGV[$i]}"; i=$((i + 1)); } ;;
      -c|--config-env)
        GLOBALS[${#GLOBALS[@]}]="$a"; i=$((i + 1))
        if [ "$i" -lt "$n" ]; then
          cfgbad=0
          if [ "$a" = -c ]; then cfg_arg_ok "${ARGV[$i]}" || cfgbad=1; else cfg_env_arg_ok "${ARGV[$i]}" || cfgbad=1; fi
          if [ "$cfgbad" = 1 ]; then RULE="$a ${ARGV[$i]}: only $CFG_ALLOWED_LIST may be set on the command line (any other pair can run a program or pull in a file)"; return 1; fi
          GLOBALS[${#GLOBALS[@]}]="${ARGV[$i]}"; i=$((i + 1))
        fi ;;
      --config-env=*)
        if ! cfg_env_arg_ok "${a#--config-env=}"; then RULE="$a: only $CFG_ALLOWED_LIST may be set on the command line (any other pair can run a program or pull in a file)"; return 1; fi
        GLOBALS[${#GLOBALS[@]}]="$a"; i=$((i + 1)) ;;
      --version|--help|-h|--exec-path|--html-path|--man-path|--info-path|--list-cmds=*) return 0 ;;
      -*) GLOBALS[${#GLOBALS[@]}]="$a"; i=$((i + 1)) ;;
      *) SUB="$a"; i=$((i + 1)); break ;;
    esac
  done
  [ -n "$SUB" ] || return 0
  REST=("${ARGV[@]:$i}")

  # Expand a git alias (not for a built-in name, which an alias cannot shadow). Anything that cannot be read is refused.
  while :; do
    case "$SUB" in
      add|reset|checkout|switch|restore|clean|rm|stash|checkout-index|read-tree|config|commit|push|merge|rebase|pull|am|cherry-pick|revert) break ;;
    esac
    val="$("$real" "${GLOBALS[@]}" config --get "alias.$SUB" 2>/dev/null)"; rc=$?
    if [ "$rc" -ge 2 ]; then RULE="the alias alias.$SUB could not be read"; return 1; fi
    [ "$rc" = 0 ] && [ -n "$val" ] || break
    depth=$((depth + 1))
    if [ "$depth" -gt 5 ]; then RULE="an alias chain deeper than 5 cannot be judged"; return 1; fi
    case "$val" in
      "!"*)
        # A SHELL alias runs through `sh -c` and the git it calls is found in git's own exec-path, never through this shim.
        if ci_match "$val" "*git*"; then RULE="the shell alias alias.$SUB mentions git, which this shim cannot see inside (use the git command directly)"; return 1; fi
        return 0 ;;
    esac
    case "$val" in
      *\'*|*\"*|*\\*) RULE="the alias alias.$SUB holds a quote or a backslash, which this shim does not re-split"; return 1 ;;
    esac
    set -- $val
    SUB="$1"; shift
    REST=("$@" "${REST[@]}")
  done

  decide "$SUB" "${REST[@]}"
}

RULE=""
if ! evaluate "${ORIG[@]}"; then
  refuse "${ORIG[@]}"
fi
RAILS_FLOW_GIT_SHIM_DEPTH=$((depth + 1)) exec "$real" "${ORIG[@]}"
